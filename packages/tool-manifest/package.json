{
  "name": "@polyv/tool-manifest",
  "version": "0.1.1",
  "description": "Build-time MCP tool manifest generator for polyv-live-cli (Doubao MCP plugin, Story 1 / CAP-5).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist",
    "/generated"
  ],
  "scripts": {
    "build": "tsc",
    "generate": "pnpm run build && node dist/generate.js",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "polyv",
    "mcp",
    "tool-manifest",
    "doubao"
  ],
  "author": "PolyV Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0",
    "polyv-live-cli": "workspace:*"
  }
}
