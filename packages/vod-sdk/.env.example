# Copy to .env.test for the real-account integration tests (`pnpm test:integration`).
# Get the values from the PolyV console: 云点播 -> 设置 -> API接口.
# Use a test account: the integration tests upload and delete temporary videos.

# VOD keys (required)
POLYV_VOD_USER_ID=your_user_id
POLYV_VOD_SECRET_KEY=your_secret_key
POLYV_VOD_WRITE_TOKEN=your_write_token

# API credentials (optional; only the V4 endpoints need them, e.g. callback settings)
POLYV_VOD_APP_ID=
POLYV_VOD_APP_SECRET=
